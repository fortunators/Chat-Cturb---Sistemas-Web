# --- Microsserviço: notificar_usuario ---
import json
import uuid
from datetime import datetime
from zoneinfo import ZoneInfo

def enviar_notificacao_usuario(dados_da_notificacao):
    """
    Microsserviço responsável por processar e enviar uma notificação final ao usuário.
    """
    data_hora = datetime.now(ZoneInfo("America/Sao_Paulo")).strftime("%d-%m-%Y %H:%M:%S")
    destinatario_id = dados_da_notificacao.get('destinatario_id', 'N/A')
    texto = dados_da_notificacao.get('mensagem', {}).get('texto', '...')

    log_envio = {
        "data/hora":data_hora,
        "servico": "notificar_usuario",
        "mensagem": f"nova mensagem enviada com sucesso para o usuario '{destinatario_id}'.",
        "detalhes": {
            "usuario_notificado": destinatario_id,
            "preview_da_mensagem": f"{texto[:30]}..." # Mostra um trecho da mensagem
        }
    }

    # O log simula o envio efetivo de uma notificação push ou e-mail
    print("--- Detalhes da Notificação ---")
    for key, value in log_envio.items():
        if isinstance(value, dict):
            print(f"{key}:")
            for sub_key, sub_value in value.items():
                print(f"  {sub_key}: {sub_value}")
        else:
            print(f"{key}: {value}")
    print("-----------------------------")

    return True

# --- Bloco de Simulação para Apresentação ---
if __name__ == "__main__":
    print("Teste do microsserviço 'notificar_usuario'\n")

    # Simula uma notificação que chegaria do serviço SNS
    notificacao_do_sns = {

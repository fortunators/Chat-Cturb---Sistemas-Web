        "destinatario_id": "Marlon",
        "mensagem": {
            "tipo": "texto",
            "texto": "vai ter aula segunda?"
        }
    }

    print("[Processando notificação do SNS para o usuário]")
    enviar_notificacao_usuario(notificacao_do_sns)